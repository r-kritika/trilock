# Copy to .env and adjust. Every setting has a default, so this file is optional.

# Where the SQLite file, encrypted templates and evaluation output live.
TRILOCK_DATA_DIR=./data

# Fernet key used to encrypt stored biometric templates. If empty, a key is
# generated once and saved to data/template.key (git-ignored).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRILOCK_TEMPLATE_KEY=

# Which decision policy is applied to real transactions: risk_aware or fixed.
# The other policy is still computed and stored for comparison.
TRILOCK_ACTIVE_POLICY=risk_aware

# Optional JSON file that overrides risk weights / fusion thresholds.
# See docs/IMPLEMENTATION.md for the keys.
TRILOCK_POLICY_FILE=

TRILOCK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Authentication and abuse limits (defaults shown)
TRILOCK_ALLOW_REGISTRATION=true          # set false on anything shared; create admins with python -m app.cli create-admin
TRILOCK_SESSION_HOURS=8
TRILOCK_MIN_PASSWORD_LENGTH=10
TRILOCK_MAX_FAILED_LOGINS=5
TRILOCK_LOGIN_LOCK_MINUTES=15
TRILOCK_BIOMETRIC_FAILURE_LIMIT=5
TRILOCK_BIOMETRIC_WINDOW_MINUTES=15
# Hide raw/calibrated scores from normal users (admins always see them)
TRILOCK_EXPOSE_SCORES_TO_USERS=true
